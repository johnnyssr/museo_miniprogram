/**exhibit.wxss**/
.page {
  height: 100vh;
  background: #f2f7f7;
}
.empty {
  display: flex;
  height: 100vh;
  align-items: center;
  justify-content: center;
  color: #7a9196;
  font-size: 30rpx;
}
.cover {
  width: 100%;
  height: 420rpx;
}
.header {
  padding: 30rpx;
  background: #fff;
}
.name {
  font-size: 40rpx;
  font-weight: bold;
  color: #183b40;
}
.dynasty {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #1f6f78;
}
.section {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #183b40;
  margin-bottom: 16rpx;
}
.text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #3d5257;
}
.block {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.block-head {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #183b40;
}
.arrow {
  font-size: 26rpx;
  color: #1f6f78;
  font-weight: normal;
}
.block-body {
  padding: 0 30rpx 30rpx;
}
.play-btn {
  background: #1f6f78;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.video {
  width: 100%;
}
