/**exhibit.wxss**/
.page {
  height: 100vh;
  background: #eef7fa;
}
.empty {
  display: flex;
  height: 100vh;
  align-items: center;
  justify-content: center;
  color: #6a8f9c;
  font-size: 30rpx;
}

/* 图集 */
.cover-swiper {
  width: 100%;
  height: 480rpx;
  background: #d5eef4;
}
.cover {
  width: 100%;
  height: 100%;
}

/* 标题区 */
.header {
  padding: 30rpx;
  background: #fff;
}
.name {
  font-size: 40rpx;
  font-weight: bold;
  color: #0d3a48;
}
.summary {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #0e88ab;
}

/* 文字介绍 */
.section {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #0d3a48;
}
.font-btns {
  display: flex;
  gap: 16rpx;
}
.font-btn {
  font-size: 24rpx;
  color: #0e88ab;
  background: #e6f5f9;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.text {
  line-height: 1.8;
  color: #37535c;
  white-space: pre-wrap;
}
.text-toggle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #0e88ab;
  text-align: center;
}

/* 音频 / 视频 通用块 */
.block {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.block-head {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #0d3a48;
}
.arrow {
  font-size: 26rpx;
  color: #0e88ab;
  font-weight: normal;
}
.block-body {
  padding: 0 30rpx 30rpx;
}

/* 音频播放器 */
.audio-time-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.audio-time-txt {
  font-size: 22rpx;
  color: #6a8f9c;
  white-space: nowrap;
  flex-shrink: 0;
}
.audio-slider {
  flex: 1;
}
.audio-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}
.audio-step-btn {
  font-size: 26rpx;
  color: #0e88ab;
  padding: 8rpx 20rpx;
  background: #e6f5f9;
  border-radius: 20rpx;
}
.play-btn {
  background: #0e88ab;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  min-width: 160rpx;
}

/* 视频封面预览 */
.video-preview {
  position: relative;
  margin: 0 30rpx 30rpx;
  border-radius: 12rpx;
  overflow: hidden;
  height: 320rpx;
}
.video-thumb {
  width: 100%;
  height: 100%;
}
.video-play-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.32);
}
.video-play-icon {
  font-size: 64rpx;
  color: #fff;
  line-height: 1;
}
.video-play-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}
.video {
  width: 100%;
  border-radius: 12rpx;
}

/* 底部操作区 */
.bottom-bar {
  margin: 20rpx;
  padding: 24rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
}
.share-btn {
  background: #0e88ab;
  color: #fff;
  font-size: 26rpx;
  border-radius: 40rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0;
}
