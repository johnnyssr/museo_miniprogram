/**exhibit.wxss**/
.page {
  height: 100vh;
  background: #eef7fa;
}
.empty {
  display: flex;
  height: 100vh;
  align-items: center;
  justify-content: center;
  color: #6a8f9c;
  font-size: 30rpx;
}
.cover {
  width: 100%;
  height: 420rpx;
}
.header {
  padding: 30rpx;
  background: #fff;
}
.name {
  font-size: 40rpx;
  font-weight: bold;
  color: #0d3a48;
}
.dynasty {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #0e88ab;
}
.section {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #0d3a48;
  margin-bottom: 16rpx;
}
.text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #37535c;
}
.block {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.block-head {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #0d3a48;
}
.arrow {
  font-size: 26rpx;
  color: #0e88ab;
  font-weight: normal;
}
.block-body {
  padding: 0 30rpx 30rpx;
}
.play-btn {
  background: #0e88ab;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.video {
  width: 100%;
}
