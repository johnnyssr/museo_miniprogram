page {
  background: var(--ocean-bg-page);
  color: var(--ocean-text-strong);
}
.detail, .empty-fill {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.empty-fill { align-items: center; justify-content: center; }
.reading-pane { height: 0; flex: 1; }
.gallery { position: relative; margin-top: 24rpx; overflow: hidden; border-radius: 16rpx; background: var(--ocean-placeholder); }
.gallery-swiper { width: 100%; height: 410rpx; max-height: 42vh; }
.cover, .film-player { width: 100%; height: 100%; display: block; }
.gallery-count {
  position: absolute;
  bottom: 20rpx;
  right: 28rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 9rpx 18rpx;
  border-radius: 30rpx;
  color: #fff;
  background: rgba(13, 58, 72, .72);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}
.frame-icon {
  width: 19rpx;
  height: 15rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  box-shadow: -4rpx 4rpx 0 -2rpx #3a6b80, -4rpx 4rpx 0 0 currentColor;
}
.sheet { display: flex; flex-direction: column; min-height: 100%; box-sizing: border-box; max-width: 720px; margin: 0 auto; padding: 36rpx 38rpx 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.caption, .category, .section-nav, .tabs, .text-toggle { display: flex; align-items: center; }
.caption, .section-nav { justify-content: space-between; }
.category { gap: 14rpx; color: var(--ocean-primary); font-size: 24rpx; font-weight: 600; }
.category-rule { width: 32rpx; height: 4rpx; background: var(--ocean-primary); }
.visited { color: var(--ocean-text-muted); font-size: 22rpx; }
.name {
  margin-top: 14rpx;
  font-family: "Songti SC", "Noto Serif CJK SC", "STSong", serif;
  font-size: 54rpx;
  line-height: 1.26;
  font-weight: 700;
  overflow-wrap: anywhere;
}
.summary { display: block; margin-top: 16rpx; color: var(--ocean-text-body); font-size: 28rpx; line-height: 1.65; }
.section-nav { margin-top: 30rpx; border-bottom: 1px solid var(--ocean-border); }
.tabs { gap: 36rpx; }
.tab, .type-control, .text-toggle { font-size: 26rpx; }
.tab { position: relative; padding: 24rpx 0; color: var(--ocean-text-muted); }
.selected { color: var(--ocean-text-strong); font-weight: 650; }
.selected::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 5rpx; background: var(--ocean-primary); border-radius: 4rpx; }
.type-control { padding: 18rpx 0 18rpx 18rpx; color: var(--ocean-text-body); }
.article, .film { margin-top: 26rpx; }
.body-text { white-space: pre-wrap; overflow-wrap: anywhere; color: var(--ocean-text-body); line-height: 1.95; }
.text-toggle { width: fit-content; gap: 14rpx; padding: 20rpx 0; color: var(--ocean-primary); }
.chevron { width: 10rpx; height: 10rpx; border: solid currentColor; border-width: 0 2rpx 2rpx 0; transform: rotate(45deg); }
.chevron.up { transform: rotate(225deg); }
.film { position: relative; height: 0; padding-bottom: 56.25%; overflow: hidden; border-radius: 16rpx; background: var(--ocean-text-strong); }
.film-player, .film-poster, .film-scrim { position: absolute; inset: 0; }
.film-scrim { display: flex; flex-direction: column; gap: 12rpx; align-items: center; justify-content: center; color: white; font-size: 24rpx; background: rgba(13, 58, 72, .42); }
.film-play { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border: 2rpx solid white; border-radius: 50%; }
.triangle { margin-left: 5rpx; width: 0; height: 0; border: solid transparent; border-width: 12rpx 0 12rpx 20rpx; border-left-color: white; }
.footer { display: flex; flex-direction: column; gap: 20rpx; margin-top: auto; padding-top: 40rpx; }
.footer-nav { display: flex; gap: 20rpx; }
.nav-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  border: 1rpx solid var(--ocean-border);
  border-radius: var(--radius-pill);
  color: var(--ocean-primary);
  font-size: 28rpx;
  background: var(--ocean-surface);
}
.nav-btn:active { background: var(--ocean-primary-bg); }
.share {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  margin: 0;
  padding: 28rpx 0;
  border-radius: var(--radius-pill);
  background: var(--ocean-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}
.share:active { background: var(--ocean-primary-dark); }
.share::after { border: 0; }
.share-icon {
  position: relative;
  width: 22rpx;
  height: 26rpx;
}
.share-icon::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 2rpx;
  width: 3rpx;
  height: 22rpx;
  margin-left: -1.5rpx;
  background: currentColor;
  border-radius: 2rpx;
}
.share-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 2rpx;
  width: 11rpx;
  height: 11rpx;
  border-top: 3rpx solid currentColor;
  border-left: 3rpx solid currentColor;
  transform: translate(-50%, 1rpx) rotate(45deg);
}
