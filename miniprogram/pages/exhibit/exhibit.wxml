<!--exhibit.wxml-->
<view wx:if="{{notFound}}" class="empty">
  <text>未找到该展品</text>
</view>

<scroll-view wx:elif="{{exhibit}}" scroll-y class="page">
  <swiper
    wx:if="{{exhibit.images.length}}"
    class="cover-swiper"
    indicator-dots="{{exhibit.images.length > 1}}"
    indicator-color="rgba(255,255,255,0.5)"
    indicator-active-color="#ffffff"
    circular="{{exhibit.images.length > 1}}"
  >
    <swiper-item wx:for="{{exhibit.images}}" wx:key="*this">
      <image class="cover" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="onPreviewImage" />
    </swiper-item>
  </swiper>
  <view class="header">
    <text class="name">{{exhibit.name}}</text>
    <text wx:if="{{exhibit.summary}}" class="summary">{{exhibit.summary}}</text>
  </view>

  <view class="section">
    <view class="section-title">文字介绍</view>
    <text class="text">{{exhibit.text}}</text>
  </view>

  <!-- 语音介绍：可展开 -->
  <view class="block">
    <view class="block-head" bindtap="toggleAudio">
      <text>语音介绍</text>
      <text class="arrow">{{audioExpanded ? '收起' : '展开'}}</text>
    </view>
    <view wx:if="{{audioExpanded}}" class="block-body">
      <button class="play-btn" bindtap="toggleAudioPlay">
        {{audioPlaying ? '暂停' : '播放'}}
      </button>
    </view>
  </view>

  <!-- 视频介绍：可展开，展开才渲染 video -->
  <view class="block">
    <view class="block-head" bindtap="toggleVideo">
      <text>视频介绍</text>
      <text class="arrow">{{videoExpanded ? '收起' : '展开'}}</text>
    </view>
    <view wx:if="{{videoExpanded}}" class="block-body">
      <video
        class="video"
        src="{{exhibit.videoUrl}}"
        binderror="onVideoError"
      />
    </view>
  </view>
</scroll-view>
