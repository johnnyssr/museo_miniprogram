<view wx:if="{{notFound || loadFailed}}" class="empty-fill">
  <empty-state wx:if="{{notFound}}" text="未找到该展品" ctaText="看全部展品" bindcta="goList" />
  <empty-state wx:else text="展品加载失败" ctaText="重新加载" bindcta="loadExhibit" />
</view>

<view wx:elif="{{exhibit}}" class="detail">
  <scroll-view scroll-y class="reading-pane">
    <view class="sheet">
      <view class="caption">
        <view class="category"><view class="category-rule"></view>{{exhibit.category || '馆藏展品'}}</view>
        <text class="visited">✓ 已打卡</text>
      </view>
      <view class="name">{{exhibit.name}}</view>
      <text wx:if="{{exhibit.summary}}" class="summary">{{exhibit.summary}}</text>

      <view wx:if="{{exhibit.text || exhibit.images.length || exhibit.videoUrl}}" class="section-nav">
        <view class="tabs">
          <view wx:if="{{exhibit.text || exhibit.images.length}}" class="tab {{activeTab === 'text' ? 'selected' : ''}}" data-tab="text" bindtap="selectTab" aria-role="button">{{exhibit.text ? (exhibit.images.length ? '图文介绍' : '展品介绍') : '展品图集'}}</view>
          <view wx:if="{{exhibit.videoUrl}}" class="tab {{activeTab === 'video' ? 'selected' : ''}}" data-tab="video" bindtap="selectTab" aria-role="button">展品视频</view>
        </view>
        <view wx:if="{{activeTab === 'text' && exhibit.text}}" class="type-control" bindtap="chooseFont" aria-role="button" aria-label="调整正文字号">字号</view>
      </view>
      <view wx:if="{{activeTab === 'text' && exhibit.images.length}}" class="gallery">
        <swiper class="gallery-swiper" current="{{imageIndex}}" circular="{{exhibit.images.length > 1}}" bindchange="onImageChange">
          <swiper-item wx:for="{{exhibit.images}}" wx:key="*this">
            <image class="cover" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="onPreviewImage" aria-label="查看展品大图" />
          </swiper-item>
        </swiper>
        <view class="gallery-count" bindtap="onPreviewImage" aria-role="button" aria-label="查看第 {{imageIndex + 1}} 张大图">
          <view class="frame-icon"></view>
          <text>{{imageIndex + 1}} / {{exhibit.images.length}}</text>
        </view>
      </view>
      <view wx:if="{{activeTab === 'text' && exhibit.text}}" class="article">
        <text class="body-text" selectable style="font-size: {{fontSize}}rpx">{{textExpanded || !textLong ? exhibit.text : textShort}}</text>
        <view wx:if="{{textLong}}" class="text-toggle" bindtap="toggleText" aria-role="button">{{textExpanded ? '收起全文' : '展开全文'}}<view class="chevron {{textExpanded ? 'up' : ''}}"></view></view>
      </view>
      <view wx:if="{{activeTab === 'video' && exhibit.videoUrl}}" class="film">
        <video wx:if="{{videoOpen}}" id="exhibit-video" class="film-player" src="{{exhibit.videoUrl}}" poster="{{exhibit.image}}" autoplay controls bindplay="pauseNarration" binderror="onVideoError" />
        <view wx:else class="film-poster" bindtap="requestVideo" aria-role="button" aria-label="播放展品视频">
          <image wx:if="{{exhibit.image}}" class="cover" src="{{exhibit.image}}" mode="aspectFill" />
          <view class="film-scrim"><view class="film-play"><view class="triangle"></view></view><text>{{videoFailed ? '重新播放' : '播放视频'}}</text></view>
        </view>
      </view>

      <view class="footer">
        <view class="footer-nav">
          <view class="nav-btn" bindtap="goList" aria-role="button">全部展品</view>
          <view class="nav-btn" bindtap="onScan" aria-role="button">继续扫码</view>
        </view>
        <button class="share" open-type="share"><view class="share-icon"></view>分享展品</button>
      </view>
    </view>
  </scroll-view>
  <audio-player wx:if="{{exhibit.audioUrl}}" id="narration" src="{{exhibit.audioUrl}}" bindplayrequest="onAudioRequest" />
</view>
