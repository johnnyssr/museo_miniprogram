/**index.wxss**/
page {
  height: 100vh;
  background: #eef7fa;
}
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.hero {
  text-align: center;
  margin-bottom: 120rpx;
}
.title {
  font-size: 52rpx;
  font-weight: bold;
  color: #0d3a48;
}
.subtitle {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #6a8f9c;
}
.scan-btn {
  width: 70%;
  background: #0e88ab;
  color: #fff;
  border-radius: 56rpx;
  font-size: 48rpx;
  font-weight: bold;
  padding: 28rpx 0;
  line-height: 1.4;
}
.browse-link {
  margin-top: 40rpx;
  font-size: 40rpx;
  color: #0e88ab;
  padding: 24rpx 48rpx;
  border: 2rpx solid #c4e2ec;
  border-radius: 48rpx;
}
