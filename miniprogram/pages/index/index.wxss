/**index.wxss**/
page {
  height: 100vh;
  background: #eef7fa;
}
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.hero {
  text-align: center;
  margin-bottom: 120rpx;
}
.title {
  font-size: 52rpx;
  font-weight: bold;
  color: #0d3a48;
}
.subtitle {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #6a8f9c;
}
.scan-btn {
  width: 60%;
  background: #0e88ab;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
}
.hint {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #9fc4d0;
  padding: 0 60rpx;
  text-align: center;
}
.browse-link {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #0e88ab;
  padding: 12rpx 24rpx;
  border: 1rpx solid #c4e2ec;
  border-radius: 40rpx;
}
