/**index.wxss**/
page {
  height: 100vh;
  background: #f2f7f7;
}
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.hero {
  text-align: center;
  margin-bottom: 120rpx;
}
.title {
  font-size: 52rpx;
  font-weight: bold;
  color: #183b40;
}
.subtitle {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #7a9196;
}
.scan-btn {
  width: 60%;
  background: #1f6f78;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
}
.hint {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #a9bcc0;
  padding: 0 60rpx;
  text-align: center;
}
.browse-link {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #1f6f78;
  padding: 12rpx 24rpx;
  border: 1rpx solid #cfe1e2;
  border-radius: 40rpx;
}
