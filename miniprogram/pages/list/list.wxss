/**list.wxss**/
.page {
  height: 100vh;
  box-sizing: border-box;
}

/* 顶部标题 + 进度 */
.page-header {
  padding: 40rpx var(--space-lg) 0;
}
.page-title {
  font-size: var(--fs-title);
  font-weight: bold;
  color: var(--ocean-text-strong);
}

/* 打卡进度卡片 */
.progress-card {
  margin-top: var(--space-md);
  padding: 24rpx var(--space-lg);
  background: var(--ocean-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}
.progress-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-sm);
}
.progress-label {
  font-size: var(--fs-small);
  font-weight: bold;
  color: var(--ocean-text-strong);
}
.progress-count {
  font-size: var(--fs-small);
  color: var(--ocean-text-muted);
}
.progress-bar-bg {
  position: relative;
  height: 18rpx;
  background: var(--ocean-placeholder);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--ocean-primary), var(--ocean-primary-light));
  border-radius: var(--radius-pill);
  transition: width 0.4s ease;
}
.tick {
  position: absolute;
  top: 0;
  width: 2rpx;
  height: 100%;
  background: rgba(255, 255, 255, 0.7);
}
.progress-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-xs);
}
.progress-pct {
  font-size: var(--fs-caption);
  color: var(--ocean-text-muted);
}
.progress-share {
  font-size: var(--fs-caption);
  color: var(--ocean-primary);
  padding: 6rpx 20rpx;
  background: var(--ocean-primary-bg);
  border-radius: var(--radius-pill);
}

/* 搜索框 */
.search-wrap {
  margin: var(--space-md) var(--space-lg) 0;
}
.search-input {
  background: var(--ocean-surface);
  border-radius: var(--radius-pill);
  padding: 0 var(--space-lg);
  height: 80rpx;
  font-size: var(--fs-body);
  color: var(--ocean-text-strong);
  width: 100%;
  box-sizing: border-box;
}
.search-placeholder {
  color: var(--ocean-text-hint);
}

/* 分类芯片 */
.cat-scroll {
  margin-top: var(--space-md);
  white-space: nowrap;
}
.cat-row {
  display: flex;
  padding: 0 var(--space-lg);
  gap: var(--space-sm);
}
.cat-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  background: var(--ocean-surface);
  border-radius: var(--radius-pill);
  font-size: var(--fs-small);
  color: var(--ocean-text-strong);
  white-space: nowrap;
  flex-shrink: 0;
}
.cat-chip--active {
  background: var(--ocean-primary);
  color: #fff;
}

.list-bottom {
  height: 160rpx;
}

/* 继续扫码悬浮按钮 */
.scan-fab {
  position: fixed;
  right: var(--space-lg);
  bottom: 56rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 36rpx;
  background: var(--ocean-primary);
  color: #fff;
  font-size: var(--fs-small);
  font-weight: bold;
  border-radius: var(--radius-pill);
  box-shadow: 0 8rpx 24rpx rgba(14, 136, 171, 0.4);
  z-index: 20;
}
.scan-fab--hover {
  background: var(--ocean-primary-dark);
}
.scan-fab-icon {
  font-size: 30rpx;
  line-height: 1;
}

/* 离屏画布（打卡卡片） */
.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 800px;
}
