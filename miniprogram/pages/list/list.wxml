<!--list.wxml-->
<scroll-view scroll-y class="page">

  <!-- 顶部：标题 + 打卡进度卡片 -->
  <view class="page-header">
    <text class="page-title">全部展品</text>
    <view wx:if="{{totalCount > 0}}" class="progress-card">
      <view class="progress-top">
        <text class="progress-label">🐚 打卡进度</text>
        <text class="progress-count">{{visitedCount}} / {{totalCount}}</text>
      </view>
      <view class="progress-bar-bg">
        <view class="progress-bar-fill" style="width: {{percent}}%"></view>
        <view class="tick" style="left: 25%"></view>
        <view class="tick" style="left: 50%"></view>
        <view class="tick" style="left: 75%"></view>
      </view>
      <view class="progress-bottom">
        <text class="progress-pct">{{percent}}%</text>
        <text class="progress-share" bindtap="onMakeCard">生成打卡卡片</text>
      </view>
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="search-wrap">
    <input
      class="search-input"
      placeholder="搜索展品名称或简述"
      placeholder-class="search-placeholder"
      bindinput="onSearchInput"
      value="{{searchKeyword}}"
    />
  </view>

  <!-- 分类筛选 -->
  <scroll-view wx:if="{{categories.length > 1}}" scroll-x class="cat-scroll">
    <view class="cat-row">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="cat-chip {{activeCategory === item ? 'cat-chip--active' : ''}}"
        data-cat="{{item}}"
        bindtap="onCategoryTap"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- 展品列表 -->
  <empty-state
    wx:if="{{filteredList.length === 0}}"
    icon="🐚"
    text="{{searchKeyword ? '没有匹配“' + searchKeyword + '”的展品' : '暂无展品'}}"
  />

  <exhibit-card
    wx:for="{{filteredList}}"
    wx:key="id"
    exhibit="{{item}}"
    bindtap="onCardTap"
  />

  <view class="list-bottom" />

  <!-- 离屏画布：用于生成打卡卡片 -->
  <canvas type="2d" id="checkinCanvas" class="hidden-canvas"></canvas>

</scroll-view>

<!-- 继续扫码悬浮按钮 -->
<view class="scan-fab" hover-class="scan-fab--hover" bindtap="onScan">
  <text class="scan-fab-icon">⌞⌝</text>
  <text>继续扫码</text>
</view>

